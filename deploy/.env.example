# Copy to `.env` on the Oracle VM and fill in. Never commit the real .env.

# --- Public hostname (DuckDNS) --------------------------------------------
# Full hostname Caddy serves and gets a cert for.
DOMAIN=logi-api.duckdns.org
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# --- DuckDNS updater ------------------------------------------------------
# Just the label(s), no ".duckdns.org". Comma-separated for multiple.
DUCKDNS_SUBDOMAINS=logi-api
# Token from https://www.duckdns.org (shown at the top once you log in).
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# --- Database ------------------------------------------------------------
MYSQL_DATABASE=logistics
MYSQL_USER=logi
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- API image ---------------------------------------------------------
# Published by the release workflow. Pin to a released version tag for a
# reproducible deploy; `deploy-backend.yml` also publishes `:latest` and a
# per-commit `:<sha>` tag for rolling deploys off master.
API_IMAGE=ghcr.io/akashshindelogistics-lgtm/logistics-api:0.1.0

# --- App secrets ------------------------------------------------------
# Required. Random string, >= 32 chars. The release binary won't start
# without it. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional: enables AI-generated dispatch summaries.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed when ANTHROPIC_API_KEY is identity-linked rather than
# workspace-scoped — the workspace to attribute the request to. Without it
# such a key is rejected with `workspace_id_required`.
ANTHROPIC_WORKSPACE_ID=wrkspc_...
