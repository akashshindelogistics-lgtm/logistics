# Copy to `.env` on the Oracle VM and fill in. Never commit the real .env.

# --- Public hostname (DuckDNS) --------------------------------------------
# Full hostname Caddy serves and gets a cert for.
DOMAIN=logi-api.duckdns.org
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# --- DuckDNS updater ------------------------------------------------------
# Just the label(s), no ".duckdns.org". Comma-separated for multiple.
DUCKDNS_SUBDOMAINS=logi-api
# Token from https://www.duckdns.org (shown at the top once you log in).
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# --- Database ------------------------------------------------------------
MYSQL_DATABASE=logistics
MYSQL_USER=logi
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- API image ---------------------------------------------------------
# Published by the backend workflow. Lowercase owner/repo.
API_IMAGE=ghcr.io/akashshindelogistics-lgtm/logistics-api:latest

# --- App secrets ------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
